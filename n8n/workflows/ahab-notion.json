    {
      "parameters": {
        "jsCode": "// The second fence (Ahab's Python code is the first): only the Notion API\n// paths Ahab uses. Deleting only Notion's recoverable way (the owner's call,\n// 2026-10-18): a page or database to the trash on its own ({\"in_trash\": true},\n// kept 30 days), or a block with DELETE. No comments, no sharing.\nconst r = $input.first().json.body || {};\nconst method = String(r.method || 'GET').toUpperCase();\nconst url = String(r.url || '');\nconst bodyText = r.body === undefined || r.body === null ? '' : JSON.stringify(r.body);\nlet refused = '';\nif (!/^https:\\/\\/api\\.notion\\.com\\/v1\\/(search|pages|blocks|databases)(\\/|$)/.test(url)) refused = 'that address is not one of the Notion API paths Ahab uses';\nelse if (!['GET', 'POST', 'PATCH', 'DELETE'].includes(method)) refused = method + ' is not allowed';\nelse if (/[?#]|\\.\\./.test(url)) refused = 'that kind of address is not allowed (options go in query)';\nelse if (method === 'DELETE' && !/^https:\\/\\/api\\.notion\\.com\\/v1\\/blocks\\/[0-9a-f-]{32,36}$/.test(url)) refused = 'DELETE is only for one block; pages and databases go to the trash';\nelse if (/\"(archived|in_trash|is_archived)\"/.test(bodyText) && !(method === 'PATCH' && /^https:\\/\\/api\\.notion\\.com\\/v1\\/(pages|databases)\\/[0-9a-f-]{32,36}$/.test(url) && bodyText === '{\"in_trash\":true}')) refused = 'trashing goes alone: {\"in_trash\": true} on one page or database';\nreturn [{ json: { method, url, query: r.query || {}, body: r.body ?? {}, write: method !== 'GET', refused } }];"
      },
      "id": "6b2e0d00-3c4d-4e5f-8a90-000000000002",
      "name": "Check the request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "mode": "expression",
        "numberOutputs": 3,
        "output": "={{ $json.refused ? 2 : ($json.write ? 1 : 0) }}"
      },
      "id": "6b2e0d00-3c4d-4e5f-8a90-000000000003",
      "name": "Read or write",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
