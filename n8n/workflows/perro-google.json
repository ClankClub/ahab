    },
    {
      "parameters": {
        "jsCode": "// The second fence (Perro's Python code is the first): only Google API\n// addresses for the service named, no deleting, no sharing, no trashing.\n// Calendar: events on Perro's own calendar only, with no guests (an invite\n// emails people), and every change sent with sendUpdates=none.\nconst r = $input.first().json.body || {};\nconst prefixes = {\n  drive: ['https://www.googleapis.com/drive/v3/', 'https://www.googleapis.com/upload/drive/v3/'],\n  docs: ['https://docs.googleapis.com/v1/documents'],\n  sheets: ['https://sheets.googleapis.com/v4/spreadsheets'],\n  tasks: ['https://tasks.googleapis.com/tasks/v1/'],\n  contacts: ['https://people.googleapis.com/v1/'],\n  calendar: ['https://www.googleapis.com/calendar/v3/calendars/primary/events'],\n};\nconst EVENT_KEYS = ['summary', 'description', 'location', 'start', 'end', 'reminders'];\nconst method = String(r.method || 'GET').toUpperCase();\nconst url = String(r.url || '');\nconst bodyText = r.body === undefined || r.body === null ? '' : JSON.stringify(r.body);\nlet refused = '';\nif (!prefixes[r.service]) refused = 'unknown service ' + JSON.stringify(r.service);\nelse if (!prefixes[r.service].some(p => url.startsWith(p))) refused = 'that address is not a ' + r.service + ' address';\nelse if (!['GET', 'POST', 'PATCH', 'PUT'].includes(method)) refused = method + ' is not allowed (nothing gets deleted through Perro)';\nelse if (/[?#]|\\.\\.|permissions|batchDelete|deleteContact|\\/clear|emptyTrash|transferOwnership/i.test(url)) refused = 'that kind of request is not allowed (no sharing or deleting)';\nelse if (/\"trashed\"|\"permissions\"/.test(bodyText)) refused = 'trashing and sharing are not allowed';\nelse if (r.service === 'calendar') {\n  const rest = url.slice(prefixes.calendar[0].length);\n  const body = r.body ?? {};\n  const query = r.query || {};\n  if (!/^(\\/[A-Za-z0-9_-]{5,200})?$/.test(rest)) refused = \"only events on Perro's own calendar\";\n  else if (method === 'PUT') refused = 'events are changed with PATCH';\n  else if (method === 'POST' && rest) refused = 'new events are made with POST to the events list';\n  else if (method === 'PATCH' && !rest) refused = 'name the event to change';\n  else if (method === 'GET' && Object.keys(query).length) refused = 'reading one event takes no options';\n  else if (method !== 'GET' && !(Object.keys(query).length === 1 && query.sendUpdates === 'none')) refused = 'calendar changes must tell nobody (sendUpdates=none, nothing else)';\n  else if (method !== 'GET' && !(body && typeof body === 'object' && !Array.isArray(body) && Object.keys(body).every(k => EVENT_KEYS.includes(k)))) refused = 'events take only a title, times, place, notes and reminders: no guests';\n}\nreturn [{ json: { service: r.service, method, url, query: r.query || {}, body: r.body ?? {}, write: method !== 'GET', refused } }];"
      },
