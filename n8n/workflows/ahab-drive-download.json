    "jsCode": "// Read-only by construction: one GET of one file's bytes, handed back as\n// base64, since a webhook answers in JSON. Nothing here can write, share or delete.\nconst item = $input.first();\nif (!item.binary || !item.binary.data) {\n  const e = item.json && item.json.error;\n  return [{ json: { error: String((e && (e.message || e)) || 'The download failed.') } }];\n}\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nreturn [{ json: { data: buffer.toString('base64'), size: buffer.length, mimeType: item.binary.data.mimeType || '' } }];"
